@{
    Layout = null;
    var title = ViewBag.Title ?? "AutoParts";
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => current == name ? "active" : "";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>@title - AutoParts</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/autoparts.css" asp-append-version="true" rel="stylesheet">
</head>
<body data-flash="@TempData["Toast"]" data-flash-type="@TempData["ToastType"]">
    <div class="app">
        <aside id="side">
            <div class="brand">
                <b>AP</b>
                <span><strong>AutoParts</strong><small>Management System</small></span>
            </div>
            <nav>
                <a asp-controller="Dashboard" asp-action="Index" class="@Active("Dashboard")"><i>▦</i>Dashboard</a>
                <a asp-controller="Products" asp-action="Index" class="@Active("Products")"><i>◫</i>Products</a>
                <a asp-controller="Categories" asp-action="Index" class="@Active("Categories")"><i>◈</i>Categories</a>
                <a asp-controller="Warehouse" asp-action="Index" class="@Active("Warehouse")"><i>▤</i>Warehouse</a>
                <a asp-controller="Sales" asp-action="Index" class="@Active("Sales")"><i>↗</i>Sales</a>
                <a asp-controller="Orders" asp-action="Index" class="@Active("Orders")"><i>□</i>Orders</a>
                <a asp-controller="Customers" asp-action="Index" class="@Active("Customers")"><i>♙</i>Customers</a>
                <a asp-controller="Reports" asp-action="Index" class="@Active("Reports")"><i>▥</i>Reports</a>
                <a asp-controller="Users" asp-action="Index" class="@Active("Users")"><i>♙</i>Users</a>
                <a asp-controller="Settings" asp-action="Index" class="@Active("Settings")"><i>⚙</i>Settings</a>
            </nav>
            <div class="bottom">
                <span class="online">●</span> Store online
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-link">↪ Sign out</button>
                </form>
            </div>
        </aside>
        <div class="side-overlay"></div>

        <main>
            <header>
                <button id="menu" type="button" aria-label="Open menu">☰</button>
                <div class="search">⌕ <input id="globalSearch" placeholder="Search products, orders, customers..." aria-label="Search"></div>
                <div class="user">
                    <span class="avatar">ZS</span>
                    <span><b>Zufar Salayev</b><small>Administrator</small></span>
                </div>
            </header>
            <section class="content">
                @RenderBody()
            </section>
        </main>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="toast" class="toast" role="status" aria-live="polite"><div class="toast-body"></div></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/autoparts.js" asp-append-version="true"></script>
    @RenderSection("scripts", false)
</body>
</html>
