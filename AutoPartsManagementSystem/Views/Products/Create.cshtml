@{
    ViewBag.Title = "Add Product";
}
<div class="page">
    <div>
        <h1>Add Product</h1>
        <div class="muted">Fields marked * are required</div>
    </div>
    <a asp-action="Index" class="btn btn-light btn-sm">← Back to Products</a>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="card" style="max-width:860px">
    <div class="form-grid">
        <div>
            <label class="form-label" for="Name">Product name *</label>
            <input class="form-control" id="Name" name="Name" placeholder="e.g. Brake Pad Set" required>
        </div>
        <div>
            <label class="form-label" for="PartNumber">Part number *</label>
            <input class="form-control mono" id="PartNumber" name="PartNumber" placeholder="BP-53482" required>
        </div>
        <div>
            <label class="form-label" for="BrandId">Brand</label>
            <select class="form-select" id="BrandId" name="BrandId"><option value="">Select brand</option><option value="1">Bosch</option><option value="2">Brembo</option><option value="3">Mann</option><option value="4">NGK</option></select>
        </div>
        <div>
            <label class="form-label" for="CategoryId">Category</label>
            <select class="form-select" id="CategoryId" name="CategoryId"><option value="">Select category</option><option value="1">Engine</option><option value="2">Brake System</option><option value="3">Filters</option><option value="4">Suspension</option><option value="5">Electrical</option></select>
        </div>
        <div>
            <label class="form-label" for="Price">Price (UZS) *</label>
            <input class="form-control" id="Price" name="Price" type="number" min="0" placeholder="0" required>
        </div>
        <div>
            <label class="form-label" for="Quantity">Quantity</label>
            <input class="form-control" id="Quantity" name="Quantity" type="number" min="0" placeholder="0">
        </div>
        <div class="full">
            <label class="form-label" for="Description">Description</label>
            <textarea class="form-control" id="Description" name="Description" rows="3" placeholder="Compatible models, size, notes..."></textarea>
        </div>
        <div class="full">
            <label class="form-label">Image</label>
            <label class="upload">
                <input type="file" name="Image" accept="image/*" hidden>
                <span><b>Choose a file</b> or drop it here — PNG, JPG up to 2 MB</span>
            </label>
        </div>
    </div>
    <div class="form-foot">
        <button type="submit" class="btn btn-primary">Save Product</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </div>
</form>
