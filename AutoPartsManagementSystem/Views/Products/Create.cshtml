@model Product

@{
    ViewBag.Title = "Add Product";
}
<div class="page">
    <div>
        <h1>Add Product</h1>
        <div class="muted">Fields marked * are required</div>
    </div>
    <a asp-action="Index" class="btn btn-light btn-sm">← Back to Products</a>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="card" style="max-width:860px">
    <div class="form-grid">
        <div>
            <label class="form-label">Product name *</label>
            <span asp-validation-for="Name" class="text-danger small"></span>
            <input asp-for="Name" class="form-control" placeholder="e.g. Brake Pad Set" >
        </div>
        <div>
            <label class="form-label">Part number *</label>
            <span asp-validation-for="PartNumber" class="text-danger small"></span>
            <input asp-for="PartNumber" class="form-control mono" placeholder="BP-53482" >
        </div>
        <div>
            <label class="form-label">Brand</label>
            <select asp-for="Brand" class="form-select" >
                <option value="">Select brand</option>
                <option>Bosch</option>
                <option>Brembo</option>
                <option>Mann</option>
                <option>NGK</option>
            </select>
        </div>
        <div>
            <label class="form-label">Category</label>
            <select asp-for="Category" class="form-select"  ><option value="">Select category</option><option value="1">Engine</option><option value="2">Brake System</option><option value="3">Filters</option><option value="4">Suspension</option><option value="5">Electrical</option></select>
        </div>
        <div>
            <label class="form-label">Price (UZS) *</label>
            <span asp-validation-for="Price" class="text-danger small"></span>
            <input asp-for="Price" class="form-control" type="number" min="0" placeholder="0" >
        </div>
        <div>
            <label class="form-label">Quantity</label>
            <input asp-for="Quantity" class="form-control" type="number" min="0" placeholder="0">
        </div>
        <div class="full">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Compatible models, size, notes..."></textarea>
        </div>
        <div class="full">
            <label class="form-label">Image</label>
            <label class="upload">
                <input type="file" name="Image" accept="image/*" hidden>
                <span><b>Choose a file</b> or drop it here — PNG, JPG up to 2 MB</span>
            </label>
        </div>
    </div>
    <div class="form-foot">
        <button type="submit" class="btn btn-primary">Save Product</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </div>
</form>
