@model Order

@{
    ViewBag.Title = $"Order #INV-{Model.Id}";
    var statusCss = Model.Status == "Cancelled" ? "bad" : Model.Status == "Pending" ? "warn" : "ok";
    decimal subtotal = Model.Items.Sum(i => i.UnitPrice * i.Quantity);
    decimal discount = subtotal - Model.Total;
    var count = 0;
}
<div class="page">
    <div>
        <h1>Order #INV-@Model.Id</h1>
        <div class="muted">Created by @(Model.Cashier?.UserName ?? "—") · @Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</div>
    </div>
    <div class="btns">
        <button class="btn btn-light btn-sm" onclick="window.print()">⎙ Print invoice</button>
        <a asp-action="Index" class="btn btn-light btn-sm">← Back to Orders</a>
    </div>
</div>

<div class="card mb-3">
    <h3>Summary</h3>
    <div class="info">
        <div><small>Customer</small><b>@(Model.Customer?.FullName ?? "Walk-in")</b></div>
        <div><small>Phone</small><b>@(Model.Customer?.Phone ?? "—")</b></div>

        <div><small>Status</small><b><span class="badge @statusCss ">@Model.Status</span></b></div>
        <div><small>Payment</small><b>@(Model.PaymentMethod)</b></div>
    </div>
</div>

<div class="tablebox">
    <div class="tablehead">Items</div>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>#</th><th>Product</th><th>Part No.</th><th class="right">Price</th><th class="right">Qty</th><th class="right">Total</th></tr></thead>
            <tbody>
                @foreach (var i in Model.Items)
                {
                    <tr><td class="mono">@(++count)</td><td><div class="product"><div class="pic">⚙</div><span>@i.Product?.Name</span></div></td><td class="mono">@i.Product?.PartNumber</td><td class="right">@i.UnitPrice.ToString("N0")</td><td class="right">@i.Quantity</td><td class="num right">@((i.UnitPrice * i.Quantity).ToString("N0"))</td></tr>
                    
                }
            </tbody>
        </table>
    </div>
    <div class="totals">
        <div><span>Subtotal</span><span>@subtotal.ToString("N0") UZS</span></div>
        
        <div><span>Discount (@Model.DiscountPercent%)</span><span class="down">−@discount.ToString("N0") UZS</span></div>
        <div><span>Total</span><span>@Model.Total.ToString("N0") UZS</span></div>
    </div>
</div>
