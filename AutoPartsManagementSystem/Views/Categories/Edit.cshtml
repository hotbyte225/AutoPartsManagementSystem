@model Category

@{
    ViewBag.Title = "Edit Category";
}
<div class="page">
    <div>
        <h1>Edit Category</h1>
        <div class="muted">Fields marked * are required</div>
    </div>
    <a asp-action="Index" class="btn btn-light btn-sm">← Back to Category</a>
</div>
<div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="card" style="max-width:860px">
    <input type="hidden" asp-for="Id">
    <div class="form-grid">
        <div>
            <label class="form-label">Name *</label>
            <span asp-validation-for="Name" class="text-danger small"></span>
            <input asp-for="Name" class="form-control" >
        </div>       
        
        
        <div class="full">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3" ></textarea>
        </div>
        
    </div>
    <div class="form-foot">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </div>
</form>
