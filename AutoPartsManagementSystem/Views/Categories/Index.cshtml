@model List<Category>

@{
    ViewBag.Title = "Categories";
}
<div class="page">
    <div>
        <h1>Categories</h1>
        <div class="muted">Organize parts by category</div>
    </div>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#categoryModal">+ Add Category</button>
</div>

<div class="tablebox">
    <div class="toolbar">
        <input class="form-control" data-filter="#catTable" placeholder="Search categories..." aria-label="Search categories">
    </div>
    <div class="table-responsive">
        <table class="table" id="catTable">
            <thead><tr><th>Name</th><th>Description</th><th>Products</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model){
                <tr>
                    <td class="fw-semibold">@c.Name</td>
                    <td class="muted">@c.Description</td>
                    <td class="num text-primary">@c.Products.Count()</td>
                    <td><div class="actions"><button class="icon-btn edit" title="Edit">✎</button><form asp-action="Delete" asp-route-id="1" method="post" data-confirm="Delete Engine?"><button class="icon-btn del" title="Delete">✕</button></form></div></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Create" method="post" class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="categoryModalLabel">Add Category</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label" for="cName">Name *</label><input class="form-control" id="cName" name="Name" placeholder="e.g. Transmission" required></div>
                <div><label class="form-label" for="cDesc">Description</label><textarea class="form-control" id="cDesc" name="Description" rows="3"></textarea></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save Category</button></div>
        </form>
    </div>
</div>
