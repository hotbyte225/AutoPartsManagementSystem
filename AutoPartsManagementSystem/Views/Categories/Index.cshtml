@{
    ViewBag.Title = "Categories";
}
<div class="page">
    <div>
        <h1>Categories</h1>
        <div class="muted">Organize parts by category</div>
    </div>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#categoryModal">+ Add Category</button>
</div>

<div class="tablebox">
    <div class="toolbar">
        <input class="form-control" data-filter="#catTable" placeholder="Search categories..." aria-label="Search categories">
    </div>
    <div class="table-responsive">
        <table class="table" id="catTable">
            <thead><tr><th>#</th><th>Name</th><th>Description</th><th>Products</th><th></th></tr></thead>
            <tbody>
                <tr><td class="mono">1</td><td class="fw-semibold">Engine</td><td class="muted">Engine parts and components</td><td class="num text-primary">248</td><td><div class="actions"><button class="icon-btn edit" title="Edit">✎</button><form asp-action="Delete" asp-route-id="1" method="post" data-confirm="Delete Engine?"><button class="icon-btn del" title="Delete">✕</button></form></div></td></tr>
                <tr><td class="mono">2</td><td class="fw-semibold">Brake System</td><td class="muted">Brake pads, discs, calipers</td><td class="num text-primary">132</td><td><div class="actions"><button class="icon-btn edit" title="Edit">✎</button><form asp-action="Delete" asp-route-id="2" method="post" data-confirm="Delete Brake System?"><button class="icon-btn del" title="Delete">✕</button></form></div></td></tr>
                <tr><td class="mono">3</td><td class="fw-semibold">Filters</td><td class="muted">Oil, air, fuel and cabin filters</td><td class="num text-primary">127</td><td><div class="actions"><button class="icon-btn edit" title="Edit">✎</button><form asp-action="Delete" asp-route-id="3" method="post" data-confirm="Delete Filters?"><button class="icon-btn del" title="Delete">✕</button></form></div></td></tr>
                <tr><td class="mono">4</td><td class="fw-semibold">Suspension</td><td class="muted">Shock absorbers, springs, hubs</td><td class="num text-primary">141</td><td><div class="actions"><button class="icon-btn edit" title="Edit">✎</button><form asp-action="Delete" asp-route-id="4" method="post" data-confirm="Delete Suspension?"><button class="icon-btn del" title="Delete">✕</button></form></div></td></tr>
                <tr><td class="mono">5</td><td class="fw-semibold">Electrical</td><td class="muted">Batteries, bulbs, wiring</td><td class="num text-primary">96</td><td><div class="actions"><button class="icon-btn edit" title="Edit">✎</button><form asp-action="Delete" asp-route-id="5" method="post" data-confirm="Delete Electrical?"><button class="icon-btn del" title="Delete">✕</button></form></div></td></tr>
                <tr><td class="mono">6</td><td class="fw-semibold">Tires &amp; Wheels</td><td class="muted">Tires, rims, wheel accessories</td><td class="num text-primary">85</td><td><div class="actions"><button class="icon-btn edit" title="Edit">✎</button><form asp-action="Delete" asp-route-id="6" method="post" data-confirm="Delete Tires & Wheels?"><button class="icon-btn del" title="Delete">✕</button></form></div></td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Create" method="post" class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="categoryModalLabel">Add Category</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label" for="cName">Name *</label><input class="form-control" id="cName" name="Name" placeholder="e.g. Transmission" required></div>
                <div><label class="form-label" for="cDesc">Description</label><textarea class="form-control" id="cDesc" name="Description" rows="3"></textarea></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save Category</button></div>
        </form>
    </div>
</div>
