@model Customer

@{
    ViewBag.Title = "Edit Customer";
}
<div class="page">
    <div>
        <h1>Edit Category</h1>
        <div class="muted">Fields marked * are required</div>
    </div>
    <a asp-action="Index" class="btn btn-light btn-sm">← Back to Category</a>
</div>
<div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="card" style="max-width:860px">
    <input type="hidden" asp-for="Id">
    <div class="form-grid">
        <div>
            <label class="form-label">Full Name *</label>
            <span asp-validation-for="FullName" class="text-danger small"></span>
            <input asp-for="FullName" class="form-control">
        </div>

        
        <div>
            <label class="form-label">Phone *</label>
            <span asp-validation-for="Phone" class="text-danger small"></span>
            <input asp-for="Phone" type="tel" class="form-control">
        </div>

        <div>
            <label class="form-label">Email *</label>
            <span asp-validation-for="Email" class="text-danger small"></span>
            <input asp-for="Email" type="email" class="form-control">
        </div>

        <div>
            <label class="form-label">Type *</label>
            <span asp-validation-for="Type" class="text-danger small"></span>
            <select asp-for="Type" class="form-control"><option>Individual</option><option>Company</option></select>
        </div>
    </div>
    <div class="form-foot">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </div>
</form>
