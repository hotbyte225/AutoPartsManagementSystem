@{
    ViewBag.Title = "Customers";
}
<div class="page">
    <div>
        <h1>Customers</h1>
        <div class="muted">412 registered customers</div>
    </div>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#customerModal">+ Add Customer</button>
</div>

<div class="tablebox">
    <div class="toolbar">
        <input class="form-control" data-filter="#custTable" placeholder="Search by name or phone..." aria-label="Search customers">
        <select class="form-select" aria-label="Type"><option>All types</option><option>Individual</option><option>Company</option></select>
    </div>
    <div class="table-responsive">
        <table class="table" id="custTable">
            <thead><tr><th>Customer</th><th>Type</th><th>Phone</th><th>Email</th><th>Orders</th><th class="right">Total spent (UZS)</th><th></th></tr></thead>
            <tbody>
                <tr><td><div class="product"><span class="avatar sm soft">AK</span><span>Azizbek Karimov</span></div></td><td><span class="badge off">Individual</span></td><td class="mono">+998 90 123 45 67</td><td class="muted">azizbek@mail.uz</td><td class="num text-primary">12</td><td class="num right">14,820,000</td><td><div class="actions"><button class="icon-btn edit" title="Edit">✎</button><form asp-action="Delete" asp-route-id="1" method="post" data-confirm="Delete Azizbek Karimov?"><button class="icon-btn del" title="Delete">✕</button></form></div></td></tr>
                <tr><td><div class="product"><span class="avatar sm soft">AS</span><span>Auto Service Pro</span></div></td><td><span class="badge violet">Company</span></td><td class="mono">+998 71 200 10 10</td><td class="muted">info@autoservice.uz</td><td class="num text-primary">48</td><td class="num right">96,400,000</td><td><div class="actions"><button class="icon-btn edit" title="Edit">✎</button><form asp-action="Delete" asp-route-id="2" method="post" data-confirm="Delete Auto Service Pro?"><button class="icon-btn del" title="Delete">✕</button></form></div></td></tr>
                <tr><td><div class="product"><span class="avatar sm soft">SJ</span><span>Sardor Jabborov</span></div></td><td><span class="badge off">Individual</span></td><td class="mono">+998 91 111 22 33</td><td class="muted">sardor@mail.uz</td><td class="num text-primary">8</td><td class="num right">6,150,000</td><td><div class="actions"><button class="icon-btn edit" title="Edit">✎</button><form asp-action="Delete" asp-route-id="3" method="post" data-confirm="Delete Sardor Jabborov?"><button class="icon-btn del" title="Delete">✕</button></form></div></td></tr>
                <tr><td><div class="product"><span class="avatar sm soft">RY</span><span>Rustam Yo'ldoshev</span></div></td><td><span class="badge off">Individual</span></td><td class="mono">+998 93 660 77 88</td><td class="muted">rustam@mail.uz</td><td class="num text-primary">5</td><td class="num right">9,870,000</td><td><div class="actions"><button class="icon-btn edit" title="Edit">✎</button><form asp-action="Delete" asp-route-id="4" method="post" data-confirm="Delete Rustam Yo'ldoshev?"><button class="icon-btn del" title="Delete">✕</button></form></div></td></tr>
                <tr><td><div class="product"><span class="avatar sm soft">UA</span><span>Umid Abdullayev</span></div></td><td><span class="badge off">Individual</span></td><td class="mono">+998 93 650 44 33</td><td class="muted">umid@mail.uz</td><td class="num text-primary">7</td><td class="num right">5,300,000</td><td><div class="actions"><button class="icon-btn edit" title="Edit">✎</button><form asp-action="Delete" asp-route-id="5" method="post" data-confirm="Delete Umid Abdullayev?"><button class="icon-btn del" title="Delete">✕</button></form></div></td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="customerModal" tabindex="-1" aria-labelledby="customerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Create" method="post" class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="customerModalLabel">Add Customer</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
                <div class="form-grid">
                    <div class="full"><label class="form-label" for="cuName">Full name / company *</label><input class="form-control" id="cuName" name="Name" required></div>
                    <div><label class="form-label" for="cuPhone">Phone *</label><input class="form-control" id="cuPhone" name="Phone" type="tel" placeholder="+998 __ ___ __ __" required></div>
                    <div><label class="form-label" for="cuType">Type</label><select class="form-select" id="cuType" name="Type"><option>Individual</option><option>Company</option></select></div>
                    <div class="full"><label class="form-label" for="cuMail">Email</label><input class="form-control" id="cuMail" name="Email" type="email"></div>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save Customer</button></div>
        </form>
    </div>
</div>
