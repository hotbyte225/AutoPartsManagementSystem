@model SaleViewModel
@using System.Globalization
@{
    ViewBag.Title = "New Sale";
}
<div class="page">
    <div>
        <h1>New Sale</h1>
        <div class="muted">Tap a product to add it to the cart</div>
    </div>
</div>

<form asp-action="Checkout" method="post" class="pos">
    <div>
        <div class="d-flex gap-2 flex-wrap">
            <input class="form-control flex-grow-1" style="max-width:none;width:auto" placeholder="Search product or scan barcode..." aria-label="Search product" oninput="document.querySelectorAll('.tile').forEach(t=>t.parentElement.style.display=t.textContent.toLowerCase().includes(this.value.toLowerCase())?'':'none')">
            <select class="form-select" style="width:auto" name="CustomerId" aria-label="Customer">
                <option value="">Walk-in customer</option>
                @{foreach (var c in Model.Customers){
                    <option value="@c.Id">@c.FullName</option>
                }}
            </select>
        </div>
        <div class="tiles">

                @{
                    foreach (var p in Model.Products)
                    {
                        var stockCss  = p.Quantity <= 5 ? "down" : "up";
                        var stockText = p.Quantity == 0 ? "Out of stock"
                                      : p.Quantity <= 5 ? $"Only {p.Quantity} left"
                                      : $"{p.Quantity} in stock";

                            <div><button type="button" class="tile" data-id="@p.Id" data-name="@p.Name" data-price="@p.Price.ToString(CultureInfo.InvariantCulture)" disabled="@(p.Quantity == 0)"><div class="pic">💨</div><b>@p.Name</b><span class="mono">@p.PartNumber</span><strong>@p.Price.ToString(CultureInfo.InvariantCulture)</strong><small class="@stockCss">@stockText</small></button></div>
                        
                    }} 
        </div>
    </div>

    <aside class="cart">
        <div class="tablehead">Cart <span class="muted fw-normal" id="cartCount">0 items</span></div>
        <div class="cart-list" id="cartList"></div>
        <div class="cart-foot">
            <div class="line"><span>Subtotal</span><span class="num" id="subtotal">0 UZS</span></div>
            <div class="line"><label for="discount">Discount %</label><input class="form-control text-end" id="discount" name="DiscountPercent" type="number" min="0" max="100" value="0"></div>
            <div class="line"><label for="payment">Payment</label><select class="form-select" id="payment" name="PaymentMethod"><option value="Cash">Cash</option><option value="Card">Card (Uzcard / Humo)</option><option value="Transfer">Bank transfer</option></select></div>
            <div class="line total"><span>Total</span><span id="total">0 UZS</span></div>
            <button type="submit" class="btn btn-success" id="checkout">Complete Sale</button>
        </div>
    </aside>
</form>
