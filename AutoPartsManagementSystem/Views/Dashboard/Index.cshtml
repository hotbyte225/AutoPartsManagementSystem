@model DashboardViewModel
@using System.Globalization

@{
    ViewBag.Title = "Dashboard";

   
    var max = Model.SalesChart.Count == 0 ? 0
        : Model.SalesChart.Max(d => Math.Max(d.ThisWeek, d.LastWeek));

    string BarHeight(decimal value) =>
        max == 0 ? "0" : (value / max * 100).ToString("0", CultureInfo.InvariantCulture);

    
    string PctText(decimal? p, string suffix) =>
        p is null ? "— " + suffix
        : p >= 0 ? $"↑ {p}% {suffix}"
        : $"↓ {Math.Abs(p.Value)}% {suffix}";

    string PctCss(decimal? p) => p is null ? "" : p >= 0 ? "up" : "down";

    string StatusCss(string s) => s switch
    {
        "Paid" => "ok",
        "Pending" => "warn",
        _ => "bad"
    };

    string FormatDate(DateTime d) =>
        d.Date == DateTime.Today ? $"Today {d:HH:mm}"
        : d.Date == DateTime.Today.AddDays(-1) ? $"Yesterday {d:HH:mm}"
        : d.ToString("dd.MM.yyyy HH:mm");
}

<div class="page">
    <div>
        <h1>Dashboard</h1>
        <div class="muted">Overview of your auto parts business</div>
    </div>
    <a asp-controller="Sales" asp-action="Index" class="btn btn-primary btn-sm">+ New Sale</a>
</div>

<div class="stats">
    <div class="stat">
        <label>Total Products</label>
        <strong>@Model.TotalProducts.ToString("N0")</strong>
        <span>in @Model.CategoriesCount categories</span>
    </div>
    <div class="stat">
        <label>Today's Sales (UZS)</label>
        <strong>@Model.TodaySales.ToString("N0")</strong>
        <span class="@PctCss(Model.SalesChangePercent)">@PctText(Model.SalesChangePercent, "vs yesterday")</span>
    </div>
    <div class="stat">
        <label>Orders (7 days)</label>
        <strong>@Model.WeekOrders</strong>
        <span class="@PctCss(Model.OrdersChangePercent)">@PctText(Model.OrdersChangePercent, "vs previous 7 days")</span>
    </div>
    <div class="stat">
        <label>Low Stock</label>
        <strong>@Model.LowStockCount</strong>
        <span class="@(Model.LowStockCount > 0 ? "down" : "up")">
            @(Model.LowStockCount > 0 ? "Requires attention" : "All good")
        </span>
    </div>
</div>

<div class="grid">
    <div class="card">
        <div class="card-head">
            <h3>Sales Overview</h3>
            <div class="legend">
                <span><i style="background:#bfdbfe"></i>Previous 7 days</span>
                <span><i style="background:#3b82f6"></i>Last 7 days</span>
            </div>
        </div>
        <div class="bars pairs">
            @foreach (var d in Model.SalesChart)
            {
                <div class="bar" style="height:@BarHeight(d.LastWeek)%" title="@d.Day (prev): @d.LastWeek.ToString("N0")"></div>
                <div class="bar" style="height:@BarHeight(d.ThisWeek)%" title="@d.Day: @d.ThisWeek.ToString("N0")"></div>
            }
        </div>
        <div class="labels">
            @foreach (var d in Model.SalesChart)
            {
                <span>@d.Day</span>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-head">
            <h3>Low Stock Products</h3>
            <a asp-controller="Products" asp-action="Index" class="small fw-semibold">View all</a>
        </div>
        @if (!Model.LowStockItems.Any())
        {
            <div class="muted" style="margin-top:15px">All products are in stock.</div>
        }
        @foreach (var p in Model.LowStockItems)
        {
            <div class="product" style="margin:15px 0">
                <div class="pic">@(string.IsNullOrEmpty(p.Name) ? "?" : p.Name.Substring(0, 1).ToUpper())</div>
                <span>@p.Name</span>
                <span class="badge @(p.Quantity <= 2 ? "bad" : "warn") ms-auto">
                    @(p.Quantity == 0 ? "Out" : $"{p.Quantity} left")
                </span>
            </div>
        }
    </div>
</div>

<div class="tablebox mt-3">
    <div class="tablehead">
        Recent Sales
        <a asp-controller="Orders" asp-action="Index">View all orders</a>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr><th>Invoice</th><th>Customer</th><th>Amount</th><th>Status</th><th>Date</th></tr>
            </thead>
            <tbody>
                @if (!Model.RecentSales.Any())
                {
                    <tr><td colspan="5" class="muted">No sales yet.</td></tr>
                }
                @foreach (var o in Model.RecentSales)
                {
                    <tr>
                        <td><a class="link" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">#INV-@o.Id</a></td>
                        <td>@o.CustomerName</td>
                        <td class="num">@o.Total.ToString("N0") UZS</td>
                        <td><span class="badge @StatusCss(o.Status)">@o.Status</span></td>
                        <td class="muted">@FormatDate(o.OrderDate)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>